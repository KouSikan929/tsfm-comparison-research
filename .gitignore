# Large, regenerable model artifacts -- re-downloaded automatically via
# huggingface_hub (Kronos/Lag-Llama/TimesFM) or regenerated by rerunning
# training (iTransformer), so not worth committing.
data/checkpoints/
models/iTransformer/checkpoints/

# iTransformer's own intermediate per-run dumps (pred.npy/true.npy/metrics.npy,
# visualization PDFs). The actual deliverable results live in data/results/,
# written by scripts/eval_itransformer.py from these.
models/iTransformer/results/
models/iTransformer/test_results/

# Python cruft
__pycache__/
*.pyc
*.pyo

# macOS metadata carried over from cross-machine (Mac<->Windows) file sync
._*
.DS_Store

# Local scratch logs from background training runs (not deliverables)
scratch_*.log

# Conda/venv envs are never inside this project directory, but just in case
.venv/
venv/
